# CrediPlus — copie para .env no desenvolvimento local.
# Nunca coloque segredos reais neste arquivo.

NODE_ENV=development

# --- Aplicação ---
# Domínio público ainda não definido. Em local, use localhost.
APP_NAME=CrediPlus
APP_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000
API_PORT=4000
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000

# Cookie de sessão (Fase 2). Vazio em localhost.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# Origens permitidas no CORS (separadas por vírgula). Nunca use * em produção.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- PostgreSQL ---
# API usa role sem BYPASSRLS. Migrations usam o owner.
DATABASE_URL=postgres://crediplus_app:crediplus_app_dev_only@localhost:5432/crediplus
DATABASE_MIGRATE_URL=postgres://crediplus:crediplus_dev_only@localhost:5432/crediplus

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) ---
# Dev: MinIO. Produção: Cloudflare R2.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=crediplus-dev
S3_ACCESS_KEY=crediplus_minio
S3_SECRET_KEY=crediplus_minio_dev_only
S3_FORCE_PATH_STYLE=true

# --- E-mail (Resend em staging/prod; Mailpit no Docker local) ---
EMAIL_PROVIDER=mailpit
EMAIL_FROM=CrediPlus <dev@localhost>
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=

# --- Criptografia (CPF, TOTP, chaves de pagamento/Meta) ---
# Gere com: openssl rand -base64 32
APP_ENCRYPTION_KEY=

# --- Super Admin bootstrap (Fase 2, script one-shot) ---
# Não commitar valores reais. Sem senha default no repositório.
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
